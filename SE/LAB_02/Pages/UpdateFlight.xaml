<Window
    Height="600"
    Title="UpdateFlight"
    Width="500"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    x:Class="lab2_15.Pages.UpdateFlight"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:lab2_15.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.Resources>
        <ResourceDictionary Source="../styles.xaml" />
    </Window.Resources>
    <Grid Margin="20">
        <StackPanel
            HorizontalAlignment="Center"
            Margin="0,20,0,0"
            VerticalAlignment="Top"
            Width="350">

            <!--  Заголовок  -->
            <TextBlock
                FontSize="24"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Text="Оновити авіарейс" />

            <!--  Введення точки вильоту  -->
            <TextBlock
                FontSize="16"
                Margin="0,10,0,5"
                Text="Точка вильоту" />
            <TextBox
                BorderThickness="2"
                Height="40"
                Padding="10"
                Text="{Binding Departure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <!--  Введення точки прибуття  -->
            <TextBlock
                FontSize="16"
                Margin="0,10,0,5"
                Text="Точка прильоту" />
            <TextBox
                BorderThickness="2"
                Height="40"
                Padding="10"
                Text="{Binding Arrival, UpdateSourceTrigger=PropertyChanged}" />

            <!--  Введення дати вильоту  -->
            <TextBlock
                FontSize="16"
                Margin="0,10,0,5"
                Text="Дата вильоту" />
            <TextBox
                BorderThickness="2"
                Height="40"
                Padding="10"
                Text="{Binding Date, UpdateSourceTrigger=PropertyChanged}" />

            <!--  Введення часу польоту  -->
            <TextBlock
                FontSize="16"
                Margin="0,10,0,5"
                Text="Час польоту" />
            <TextBox
                BorderThickness="2"
                Height="40"
                Padding="10"
                Text="{Binding FlightTime, UpdateSourceTrigger=PropertyChanged}" />

            <!--  Кнопка для оновлення рейсу  -->
            <Button
                Click="AddFlight_Click"
                Content="Оновити рейс"
                FontWeight="Bold"
                Height="40"
                Margin="0,20,0,0" />

            <!--  Повідомлення про статус  -->
            <TextBlock
                FontSize="14"
                HorizontalAlignment="Center"
                Margin="0,10,0,0"
                x:Name="StatusMessage" />
        </StackPanel>
    </Grid>
</Window>
