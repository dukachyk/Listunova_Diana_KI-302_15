<Window
    Height="600"
    Title="AddFlight"
    Width="600"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    x:Class="lab2_15.Pages.AddFlight"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:lab2_15.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.Resources>
        <ResourceDictionary Source="../styles.xaml" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            FontSize="30"
            FontWeight="Bold"
            Grid.Row="0"
            HorizontalAlignment="Center"
            Margin="0,10,0,10"
            Text="Додати авіарейс" />
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            Margin="0,20,0,0"
            VerticalAlignment="Top"
            Width="400">
            <TextBlock
                FontSize="16"
                FontWeight="SemiBold"
                Text="Точка вильоту" />
            <TextBox
                BorderThickness="2"
                Height="40"
                Padding="10"
                Text="{Binding Departure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                FontSize="16"
                FontWeight="SemiBold"
                Margin="0,10,0,0"
                Text="Точка прильоту" />
            <TextBox
                BorderThickness="2"
                Height="40"
                Padding="10"
                Text="{Binding Arrival, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                FontSize="16"
                FontWeight="SemiBold"
                Margin="0,10,0,0"
                Text="Дата вильоту" />
            <TextBox
                BorderThickness="2"
                Height="40"
                Padding="10"
                Text="{Binding Date, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                FontSize="16"
                FontWeight="SemiBold"
                Margin="0,10,0,0"
                Text="Час польоту" />
            <TextBox
                BorderThickness="2"
                Height="40"
                Padding="10"
                Text="{Binding FlightTime, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Click="AddFlight_Click"
                Content="Додати рейс"
                FontWeight="Bold"
                Height="40"
                Margin="0,20,0,0" />
            <TextBlock
                FontSize="14"
                HorizontalAlignment="Center"
                Margin="0,10,0,0"
                x:Name="StatusMessage" />
        </StackPanel>
    </Grid>
</Window>
