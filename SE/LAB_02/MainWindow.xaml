<Window
    Height="450"
    Title="MainWindow"
    Width="800"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    x:Class="lab2_15.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:lab2_15"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.Resources>
        <ResourceDictionary Source="styles.xaml" />
    </Window.Resources>
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button
                Click="SearchFlightsButton_Click"
                Content="Пошук авіарейсів"
                FontSize="14"
                Height="50"
                Width="200" />
            <Button
                Click="AddFlightButton_Click"
                Content="Додати авіарейс"
                FontSize="14"
                Height="50"
                Margin="0,10,0,0"
                Width="200" />
            <Button
                Click="OpenUpdateFlight_Click"
                Content="Оновити рейс"
                FontSize="14"
                Height="50"
                Margin="0,10,0,0"
                Width="200" />
            <Button
                Click="OpenSearchConnectingFlights_Click"
                Content="Пошук рейсів з пересадками"
                FontSize="14"
                Height="50"
                Margin="0,10,0,0"
                Width="200" />
        </StackPanel>
    </Grid>
</Window>